<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Family Travel Tracker</title>
  <link rel="stylesheet" href="/styles/main.css">
</head>

<body>
  <div class="page-shell" style="--member-color: <%= color %>;">
    <header class="topbar">
      <div>
        <h1>Family Travel Tracker</h1>
      </div>
      <div class="visit-count">
        <span>Visited</span>
        <strong><%= total %></strong>
      </div>
    </header>

    <main class="dashboard">
      <aside class="panel family-panel">
        <div class="panel-header">
          <h2>Family members</h2>
        </div>

        <form class="member-picker" action="/api-users" method="post">
          <div class="member-list">
            <% users.forEach(function(user) { %>
              <button type="submit" name="user" value="<%= user.id %>" class="member-card" style="--member-color: <%= user.color %>;">
                <span class="member-dot"></span>
                <span class="member-name"><%= user.name %></span>
              </button>
            <% }); %>
          </div>

          <button type="submit" name="add" value="new" class="member-card add-member">
            <span class="member-icon">+</span>
            <span>Add family member</span>
          </button>
        </form>
      </aside>

      <section class="panel map-panel">
        <div class="panel-header">
          <div>
            <p class="eyebrow">Current traveler</p>
            <h2>India Map</h2>
          </div>
          <div class="status-pill">
            <span class="status-dot"></span>
            Active
          </div>
        </div>

