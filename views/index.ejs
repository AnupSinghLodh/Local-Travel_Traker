          <button type="submit" formaction="/api/visited" class="primary-btn" style="--member-color: <%= color %>;">Add destination</button>
          <button type="submit" formaction="/api/visited/delete" class="secondary-btn">Remove</button>
          <button type="submit" formaction="/api/users/delete" class="danger-btn">Delete member</button>
        </div>
      </form>
    </section>
  </div>


<script>
  const state_codes = "<%= states %>".split(",")
    state_codes.forEach(code => {
      const state = document.getElementById(code);
      if (state) {
          state.style.fill = "<%= color %>";
      }
  });
</script>
</body>

</html>